// ==========================================
// PROCESAMIENTO DEL FORMULARIO
// ==========================================
function procesarFormulario(datos) {
  try {
    let urlCarpeta = "Sin archivos";
    if(ID_CARPETA_RAIZ && ID_CARPETA_RAIZ !== '') {
        let fechaStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyyMMdd_HHmmss");
        let nombreCarpeta = datos.laboratorio + '_' + datos.codigo + '_' + fechaStr;
        let carpetaPadre = DriveApp.getFolderById(ID_CARPETA_RAIZ);
        let nuevaCarpeta = carpetaPadre.createFolder(nombreCarpeta);
        urlCarpeta = nuevaCarpeta.getUrl();

        if(datos.archivosBase64 && datos.archivosBase64.length > 0) {
            datos.archivosBase64.forEach(fileData => {
                let blob = Utilities.newBlob(Utilities.base64Decode(fileData.bytes), fileData.mimeType, fileData.filename);
                nuevaCarpeta.createFile(blob);
            });
        }
    }
    
    let hoja = SpreadsheetApp.openById(ID_HOJA).getSheetByName('Seguimiento_de_contenido'); 
    if(!hoja) hoja = SpreadsheetApp.openById(ID_HOJA).getSheets()[0];
    
    let maxCol = hoja.getLastColumn() < 1 ? 1 : hoja.getLastColumn();
    let headers = hoja.getRange(1, 1, 1, maxCol).getValues()[0];
    
    while(headers.length > 0 && headers[headers.length-1] === "") headers.pop();
    
    let maxRefIndex = datos.refacciones.length;
    for (let i = 1; i <= maxRefIndex; i++) {
        let refColName = 'Refacción ' + i;
        let codColName = 'Código R' + i;
        if (!headers.includes(refColName)) headers.push(refColName);
        if (!headers.includes(codColName)) headers.push(codColName);
    }
    
    if (!headers.includes('Archivo')) {
        headers.push('Archivo');
    } else {
        let archivoIdx = headers.indexOf('Archivo');
        headers.splice(archivoIdx, 1);
        headers.push('Archivo');
    }
    
    hoja.getRange(1, 1, 1, headers.length).setValues([headers]);
    
    let rowData = new Array(headers.length).fill("");
    function setVal(headerName, val) {
        let idx = headers.indexOf(headerName);
        if(idx !== -1) rowData[idx] = val;
    }
    
    setVal('Responsable', datos.responsable);
    setVal('Laboratorio', datos.laboratorio); 
    setVal('Código', datos.codigo);
    setVal('Descripción', datos.descripcion);
    setVal('Número de serie del equipo', datos.numSerie);
    setVal('Categoría', datos.categoria);
    setVal('Fecha de revisión', datos.fecha);
    setVal('Estado', datos.estado);
    setVal('Procedencia', datos.procedencia);
    setVal('Detalles', datos.detalles);
    
    for (let i = 0; i < maxRefIndex; i++) {
        setVal('Refacción ' + (i+1), datos.refacciones[i].refaccion);
        setVal('Código R' + (i+1), datos.refacciones[i].codigoR);
    }
    setVal('Archivo', urlCarpeta);
    hoja.appendRow(rowData);
    return { success: true, urlCarpeta: urlCarpeta };
  } catch(e) {
    return { success: false, error: e.toString() };
  }
}

// ==========================================
// FUNCIÓN AUXILIAR: Letras de columnas
// ==========================================
function obtenerLetraColumna(hoja, nombreEncabezado) {
  let ultimaCol = hoja.getLastColumn();
  if (ultimaCol < 1) return null;
  let encabezados = hoja.getRange(1, 1, 1, ultimaCol).getValues()[0];
  let indice = encabezados.indexOf(nombreEncabezado);
  if (indice === -1) return null;
  let columna = indice + 1;
  let letra = '';
  while (columna > 0) {
    let temp = (columna - 1) % 26;
    letra = String.fromCharCode(temp + 65) + letra;
    columna = (columna - temp - 1) / 26;
  }
  return letra;
}

// ==========================================
// SUPER DASHBOARD DIRECTIVO (Ya lo tienes)
// ==========================================
function generarDashboardKPIs() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const hojaDatos = ss.getSheetByName('Seguimiento_de_contenido');
  if (!hojaDatos) {
    SpreadsheetApp.getUi().alert('Error: No se encontró "Seguimiento_de_contenido".');
    return;
  }
  // Mapeo
  let ultimaCol = hojaDatos.getLastColumn();
  let encabezados = hojaDatos.getRange(1, 1, 1, ultimaCol).getValues()[0];
  let colResp = 'A', colCat = 'F', colCod = 'C', colEst = 'H', colProc = 'I', colLab = 'B', colFecha = 'G';
  let refCols = [];
  for (let i = 0; i < encabezados.length; i++) {
    let nombre = encabezados[i];
    if (!nombre) continue;
    let letra = obtenerLetraColumna(hojaDatos, nombre);
    if (nombre === 'Responsable') colResp = letra;
    if (nombre === 'Categoría') colCat = letra;
    if (nombre === 'Código') colCod = letra;
    if (nombre === 'Estado') colEst = letra;
    if (nombre === 'Procedencia') colProc = letra;
    if (nombre === 'Laboratorio') colLab = letra;
    if (nombre === 'Fecha de revisión') colFecha = letra;
    if (nombre.toString().startsWith('Código R')) refCols.push(letra);
  }
  
  let hojaKPIs = ss.getSheetByName('KPIs_Laboratorio');
  if (!hojaKPIs) hojaKPIs = ss.insertSheet('KPIs_Laboratorio');
  else {
    hojaKPIs.clear(); 
    let charts = hojaKPIs.getCharts();
    for (let i = 0; i < charts.length; i++) hojaKPIs.removeChart(charts[i]);
  }
  
  hojaKPIs.getRange('A1:L1').merge();
  hojaKPIs.getRange('A1').setValue('DASHBOARD DIRECTIVO DE KPIs - LABORATORIO ON')
          .setFontSize(16).setFontWeight('bold').setBackground('#0d3a66').setFontColor('white').setHorizontalAlignment('center');

  hojaKPIs.getRange('A3').setValue('Filtrar Periodo:').setFontWeight('bold');
  const reglaFiltro = SpreadsheetApp.newDataValidation().requireValueInList(['Mes Actual', 'Bimestre', 'Semestre', 'Anual', 'Todo el Histórico'], true).build();
  hojaKPIs.getRange('B3').setDataValidation(reglaFiltro).setValue('Mes Actual').setBackground('#e8f0fe').setFontWeight('bold');
  
  hojaKPIs.getRange('C2').setValue('Fecha Inicio');
  hojaKPIs.getRange('D2').setValue('Fecha Fin');
  hojaKPIs.getRange('C3').setFormula(`=IF(B3="Mes Actual"; DATE(YEAR(TODAY()); MONTH(TODAY()); 1); IF(B3="Bimestre"; DATE(YEAR(TODAY()); MONTH(TODAY())-1; 1); IF(B3="Semestre"; DATE(YEAR(TODAY()); MONTH(TODAY())-5; 1); IF(B3="Anual"; DATE(YEAR(TODAY()); 1; 1); DATE(2000; 1; 1)))))`).setNumberFormat("dd/MM/yyyy");
  hojaKPIs.getRange('D3').setFormula(`=IF(B3="Todo el Histórico"; DATE(2100; 12; 31); TODAY())`).setNumberFormat("dd/MM/yyyy");
  hojaKPIs.getRange('C2:D3').setBackground('#f4f6f9').setHorizontalAlignment('center');

  let filtroFechaQuery = `and ${colFecha} >= date '"&TEXT(C3;"yyyy-mm-dd")&"' and ${colFecha} <= date '"&TEXT(D3;"yyyy-mm-dd")&"'`;

  // BLOQUE 1
  hojaKPIs.getRange('A5:C5').merge().setValue('1. Estado General de Reparaciones').setFontWeight('bold').setBackground('#0d3a66').setFontColor('white');
  let fEstado = `=IFERROR(QUERY(Seguimiento_de_contenido!A:Z; "select ${colEst}, count(${colResp}) where ${colEst} is not null ${filtroFechaQuery} group by ${colEst} label ${colEst} 'Estado', count(${colResp}) 'Cantidad'"); "Sin datos en el periodo")`;
  hojaKPIs.getRange('A6').setFormula(fEstado);
  
  let chart1 = hojaKPIs.newChart().setChartType(Charts.ChartType.PIE).addRange(hojaKPIs.getRange('A6:B12')).setPosition(5, 3, 0, 0).setOption('title', 'Estado de Equipos').setOption('is3D', true).setOption('width', 350).setOption('height', 220).build();
  hojaKPIs.insertChart(chart1);

  hojaKPIs.getRange('G5:I5').merge().setValue('2. Procedencia de los Equipos').setFontWeight('bold').setBackground('#0d3a66').setFontColor('white');
  let fProc = `=IFERROR(QUERY(Seguimiento_de_contenido!A:Z; "select ${colProc}, count(${colResp}) where ${colProc} is not null ${filtroFechaQuery} group by ${colProc} label ${colProc} 'Procedencia', count(${colResp}) 'Cantidad'"); "Sin datos")`;
  hojaKPIs.getRange('G6').setFormula(fProc);
  
  let chart2 = hojaKPIs.newChart().setChartType(Charts.ChartType.PIE).addRange(hojaKPIs.getRange('G6:H12')).setPosition(5, 9, 0, 0).setOption('title', 'Origen de los Items').setOption('pieHole', 0.4).setOption('width', 350).setOption('height', 220).build();
  hojaKPIs.insertChart(chart2);

  // BLOQUE 2
  hojaKPIs.getRange('A17:C17').merge().setValue('3. Top Refacciones Utilizadas').setFontWeight('bold').setBackground('#0d3a66').setFontColor('white');
  if (refCols.length === 0) refCols = ['M']; 
  let filterArgs = refCols.map(l => `FILTER(Seguimiento_de_contenido!${l}2:${l}; Seguimiento_de_contenido!${colFecha}2:${colFecha} >= C3; Seguimiento_de_contenido!${colFecha}2:${colFecha} <= D3)`).join('; ');
  let fRefacciones = `=IFERROR(QUERY(FLATTEN({${filterArgs}}); "select Col1, count(Col1) where Col1 is not null and Col1 <> '' group by Col1 order by count(Col1) desc limit 10 label Col1 'Refacción', count(Col1) 'Uso'"); "Sin datos")`;
  hojaKPIs.getRange('A18').setFormula(fRefacciones);

  let chart3 = hojaKPIs.newChart().setChartType(Charts.ChartType.BAR).addRange(hojaKPIs.getRange('A18:B28')).setPosition(17, 3, 0, 0).setOption('title', 'Refacciones de Mayor Consumo').setOption('legend', {position: 'none'}).setOption('width', 350).setOption('height', 220).build();
  hojaKPIs.insertChart(chart3);

  hojaKPIs.getRange('G17:I17').merge().setValue('6. Revisiones por Laboratorio').setFontWeight('bold').setBackground('#0d3a66').setFontColor('white');
  let fLab = `=IFERROR(QUERY(Seguimiento_de_contenido!A:Z; "select ${colLab}, count(${colResp}) where ${colLab} is not null ${filtroFechaQuery} group by ${colLab} order by count(${colResp}) desc label ${colLab} 'Laboratorio', count(${colResp}) 'Revisiones'"); "Sin datos")`;
  hojaKPIs.getRange('G18').setFormula(fLab);

  let chart6 = hojaKPIs.newChart().setChartType(Charts.ChartType.COLUMN).addRange(hojaKPIs.getRange('G18:H28')).setPosition(17, 9, 0, 0).setOption('title', 'Volumen por Sucursal').setOption('legend', {position: 'none'}).setOption('width', 350).setOption('height', 220).build();
  hojaKPIs.insertChart(chart6);

  // BLOQUE 3
  hojaKPIs.getRange('A29:C29').merge().setValue('7. Aportación de Técnicos (%)').setFontWeight('bold').setBackground('#0d3a66').setFontColor('white');
  let fTecG = `=IFERROR(QUERY(Seguimiento_de_contenido!A:Z; "select ${colResp}, count(${colResp}) where ${colResp} is not null ${filtroFechaQuery} group by ${colResp} order by count(${colResp}) desc label ${colResp} 'Técnico', count(${colResp}) 'Revisiones'"); "Sin datos")`;
  hojaKPIs.getRange('A30').setFormula(fTecG);

  let chart7 = hojaKPIs.newChart().setChartType(Charts.ChartType.PIE).addRange(hojaKPIs.getRange('A30:B40')).setPosition(29, 3, 0, 0).setOption('title', 'Participación % por Técnico').setOption('is3D', true).setOption('width', 350).setOption('height', 220).build();
  hojaKPIs.insertChart(chart7);

  hojaKPIs.getRange('G29:J29').merge().setValue('8. Análisis de Scrap (Equipos Dañados)').setFontWeight('bold').setBackground('#0d3a66').setFontColor('white');
  let fScrap = `=IFERROR(QUERY(Seguimiento_de_contenido!A:Z; "select ${colCat}, ${colCod}, count(${colResp}) where ${colEst} = 'Dañado' ${filtroFechaQuery} group by ${colCat}, ${colCod} order by count(${colResp}) desc limit 10 label ${colCat} 'Categoría', ${colCod} 'Modelo', count(${colResp}) 'Scrap'"); "Sin Daños")`;
  hojaKPIs.getRange('G30').setFormula(fScrap);

  let chart8 = hojaKPIs.newChart().setChartType(Charts.ChartType.BAR).addRange(hojaKPIs.getRange('G30:I40')).setPosition(29, 10, 0, 0).setOption('title', 'Top 10 Scrap por Modelo').setOption('legend', {position: 'none'}).setOption('width', 300).setOption('height', 220).build();
  hojaKPIs.insertChart(chart8);
  
  // Estética final KPI
  hojaKPIs.setColumnWidth(1, 160); hojaKPIs.setColumnWidth(2, 90); hojaKPIs.setColumnWidth(3, 40);
  hojaKPIs.setColumnWidth(4, 80);  hojaKPIs.setColumnWidth(5, 80); hojaKPIs.setColumnWidth(6, 40);
  hojaKPIs.setColumnWidth(7, 140); hojaKPIs.setColumnWidth(8, 120); hojaKPIs.setColumnWidth(9, 60);
  
  SpreadsheetApp.getUi().alert('✅ Dashboard Directivo Generado.');
}


