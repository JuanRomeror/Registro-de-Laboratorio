  hojaM.getRange('G33').setFormula(`=IF(ISBLANK(B4); 0; COUNTIFS(Seguimiento_de_contenido!${colEst}:${colEst}; "Dañado"; Seguimiento_de_contenido!${colFecha}:${colFecha}; ">="&C3; Seguimiento_de_contenido!${colFecha}:${colFecha}; "<="&D3) - G32)`);

